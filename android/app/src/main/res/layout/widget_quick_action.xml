<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_blue"
    android:padding="14dp">

    <!-- Header row: Balance + App name -->
    <LinearLayout
        android:id="@+id/widget_qa_header"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Balance section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL BALANCE"
                android:textColor="#99FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_qa_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open Expensio"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- App branding -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expensio"
                android:textColor="#70FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Add"
                android:textColor="#55FFFFFF"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30FFFFFF"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- EXPENSE (primary pill) -->
        <LinearLayout
            android:id="@+id/widget_qa_add_Expense"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="2.2"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_danger"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- INCOME (primary pill) -->
        <LinearLayout
            android:id="@+id/widget_qa_add_income"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="2.2"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_success"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Income"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TRANSFER (primary pill) -->
        <LinearLayout
            android:id="@+id/widget_qa_add_transfer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="2.2"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_pill_neutral"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SCAN (icon button) -->
        <LinearLayout
            android:id="@+id/widget_qa_scanner"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_icon_btn_bg"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

        <!-- VOICE (icon button) -->
        <LinearLayout
            android:id="@+id/widget_qa_voice"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_icon_btn_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
